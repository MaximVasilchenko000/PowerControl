<Window x:Class="Timer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Timer.Views"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="PowerControl"
        Height="700"
        Width="700"
        MinHeight="700"
        MinWidth="700"
        Background="#0B1120"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/PowerControl.png">

    <Grid Margin="15">

        <ContentControl Content="{Binding TimerViewModel}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <views:TimerView/>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <Button Content="ВЫХОД"
                Width="110"
                Height="35"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,0,5"
                Background="#162B46"
                Foreground="#00D9FF"
                BorderBrush="#00D9FF"
                BorderThickness="1"
                FontWeight="Bold"
                Cursor="Hand"
                Click="ExitApplication_Click"/>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="PowerControl"
                        IconSource="pack://application:,,,/Resources/PowerControl.png"
                        Visibility="Visible"
                        TrayMouseDoubleClick="OpenWindow_Click">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Открыть PowerControl"
                              Click="OpenWindow_Click"/>
                    <Separator/>
                    <MenuItem Header="Выход"
                              Click="ExitApplication_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

    </Grid>
</Window>
