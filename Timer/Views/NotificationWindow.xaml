<Window x:Class="Timer.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerControl"
        Width="350"
        Height="210"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0B1120"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Border Background="#0B1120"
            BorderBrush="#2563EB"
            BorderThickness="1"
            CornerRadius="8"
            Padding="15">

        <Border.Effect>
            <DropShadowEffect Color="#28BFFF"
                              BlurRadius="15"
                              ShadowDepth="0"
                              Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="POWERCONTROL"
                       Foreground="#38BDF8"
                       FontSize="13"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center">

                <TextBlock x:Name="MessageTitle"
                           Text="ПОДТВЕРЖДЕНИЕ"
                           Foreground="#67E8F9"
                           FontSize="19"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,10,0,8"/>

                <TextBlock x:Name="MessageText"
                           Foreground="#94A3B8"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="ПОДТВЕРДИТЬ"
                        Width="125"
                        Height="30"
                        Margin="5"
                        Background="#172554"
                        Foreground="#67E8F9"
                        BorderBrush="#2563EB"
                        Click="ConfirmButton_Click"/>

                <Button Content="ОТМЕНА"
                        Width="85"
                        Height="30"
                        Margin="5"
                        Background="#3F1D2E"
                        Foreground="#FDA4AF"
                        BorderBrush="#BE123C"
                        Click="CancelButton_Click"/>

            </StackPanel>
        </Grid>
    </Border>
</Window>
