<UserControl x:Class="Timer.Views.TimerView"
             xmlns:helpers="clr-namespace:Timer.Helpers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="650">

    <UserControl.Resources>
        <helpers:TimerProgressConverter x:Key="TimerProgressConverter"/>

        <!-- Общий стиль кнопок -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#172554"/>
            <Setter Property="Foreground" Value="#67E8F9"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Поля ввода -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="Foreground" Value="#67E8F9"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Выпадающие списки -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="Foreground" Value="#67E8F9"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="190"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="#111C33"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1"
                                    CornerRadius="6"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  Margin="5,0"/>

                                <TextBlock Grid.Column="1"
                                           Text="▼"
                                           Foreground="#38BDF8"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Grid>

                            <ToggleButton x:Name="ToggleButton"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">

                                <Border Background="#111C33"
                                        BorderBrush="#2563EB"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Width="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer MaxHeight="180">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#38BDF8"/>
                            </Trigger>

                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#00D9FF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#111C33"/>
                        <Setter Property="Foreground" Value="#67E8F9"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>

                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#1E3A5F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#172554"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0B1120" Margin="8">

        <StackPanel VerticalAlignment="Center">

            <!-- Заголовок -->
            <TextBlock Text="POWER TIMER"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#38BDF8"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Настройка автоматического действия"
                       FontSize="12"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,15"/>

            <!-- Выпадающие списки -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">

                <StackPanel Margin="3">
                    <TextBlock Text="БЫСТРОЕ ВРЕМЯ"
                               FontSize="11"
                               Foreground="#67E8F9"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>

                    <ComboBox SelectedValue="{Binding SelectedPreset, Mode=TwoWay}"
                              SelectedValuePath="Tag">

                        <ComboBoxItem Content="Выберите время..." Tag="0"/>
                        <ComboBoxItem Content="5 минут" Tag="300"/>
                        <ComboBoxItem Content="10 минут" Tag="600"/>
                        <ComboBoxItem Content="15 минут" Tag="900"/>
                        <ComboBoxItem Content="30 минут" Tag="1800"/>
                        <ComboBoxItem Content="45 минут" Tag="2700"/>
                        <ComboBoxItem Content="1 час" Tag="3600"/>
                        <ComboBoxItem Content="2 часа" Tag="7200"/>
                        <ComboBoxItem Content="3 часа" Tag="10800"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="3">
                    <TextBlock Text="ДЕЙСТВИЕ"
                               FontSize="11"
                               Foreground="#67E8F9"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>

                    <ComboBox SelectedValue="{Binding SelectedAction}"
                              SelectedValuePath="Content">

                        <ComboBoxItem Content="Выключение"/>
                        <ComboBoxItem Content="Перезагрузка"/>
                        <ComboBoxItem Content="Спящий режим"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="3">
                    <TextBlock Text="УВЕДОМЛЕНИЕ"
                               FontSize="11"
                               Foreground="#67E8F9"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>

                    <ComboBox SelectedValue="{Binding NotificationLeadTimeSeconds}"
                              SelectedValuePath="Tag">

                        <ComboBoxItem Content="За 10 секунд" Tag="10"/>
                        <ComboBoxItem Content="За 30 секунд" Tag="30"/>
                        <ComboBoxItem Content="За 1 минуту" Tag="60"/>
                        <ComboBoxItem Content="За 5 минут" Tag="300"/>
                        <ComboBoxItem Content="За 10 минут" Tag="600"/>
                    </ComboBox>
                </StackPanel>

            </StackPanel>

            <!-- Ввод времени -->
            <TextBlock Text="УСТАНОВИТЕ ВРЕМЯ"
                       FontSize="12"
                       Foreground="#67E8F9"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,5">

                <StackPanel>
                    <TextBox Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Часы"
                               FontSize="11"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text=":"
                           FontSize="24"
                           Foreground="#38BDF8"
                           VerticalAlignment="Top"
                           Margin="0,7"/>

                <StackPanel>
                    <TextBox Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Минуты"
                               FontSize="11"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>

            <!-- Кольцо и кнопки + / - -->

            <!-- Кольцо и кнопки + / - -->
            <Grid HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Margin="0,5,0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="75"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопка добавления времени -->
                <Button Grid.Column="0"
            Content="+"
            Command="{Binding AddTenMinutesCommand}"
            Width="42"
            Height="42"
            Padding="0"
            Margin="0"
            FontFamily="Segoe UI"
            FontSize="25"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

                <!-- Кольцо прогресса -->
                <Grid Grid.Column="1"
          Width="200"
          Height="200">

                    <Ellipse Width="190"
                 Height="190"
                 Stroke="#1B2D4D"
                 StrokeThickness="10"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                    <Path Data="{Binding ProgressPercentage,
                     Converter={StaticResource TimerProgressConverter}}"
              Width="200"
              Height="200"
              Stretch="None"
              Stroke="#28BFFF"
              StrokeThickness="10"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

                        <Path.Effect>
                            <DropShadowEffect Color="#28BFFF"
                                  BlurRadius="15"
                                  ShadowDepth="0"
                                  Opacity="0.8"/>
                        </Path.Effect>
                    </Path>

                    <TextBlock Text="{Binding RemainingText}"
                   Foreground="#28BFFF"
                   FontSize="29"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
                </Grid>

                <!-- Кнопка удаления времени -->
                <Button Grid.Column="2"
            Content="−"
            Command="{Binding RemoveTenMinutesCommand}"
            Width="42"
            Height="42"
            Padding="0"
            Margin="0"
            FontFamily="Segoe UI"
            FontSize="25"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

            </Grid>

            <!-- Управление таймером -->
            <WrapPanel HorizontalAlignment="Center"
                       Margin="0,2,0,0">

                <Button Content="ЗАПУСТИТЬ"
                        Command="{Binding StartTimerCommand}"
                        Width="115"
                        Height="36"/>

                <Button Content="ПАУЗА"
                        Command="{Binding PauseTimerCommand}"
                        Width="85"
                        Height="36"/>

                <Button Content="ПРОДОЛЖИТЬ"
                        Command="{Binding ResumeTimerCommand}"
                        Width="115"
                        Height="36"/>

                <Button Content="СБРОС"
                        Command="{Binding CancelTimerCommand}"
                        Width="85"
                        Height="36"
                        Background="#3F1D2E"
                        BorderBrush="#BE123C"
                        Foreground="#FDA4AF"/>

            </WrapPanel>

            <!-- Статус -->
            <TextBlock Text="{Binding Status}"
                       FontSize="12"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,10,0,0"/>

        </StackPanel>
    </Grid>
</UserControl>
